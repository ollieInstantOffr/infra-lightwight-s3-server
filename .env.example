# Pail configuration.
#
# Every setting below is marked REQUIRED or optional. Only four are required,
# and ./setup.sh fills all four in for you — this file is for configuring by
# hand, or for changing something afterwards.
#
# Restart the stack after editing:  docker compose up -d
#
# ─── Deployment ───────────────────────────────────────────────────────────────
# optional — defaults to production.
#
# "production" or "development". Development relaxes the secret and public-URL
# requirements and prints human-readable logs instead of JSON.
ENV=production

# ─── Listeners ────────────────────────────────────────────────────────────────
# optional — the defaults are fine unless something else wants these ports.
#
# The ports inside the container. Both serve plain HTTP — TLS terminates at your
# reverse proxy — so despite reading as TLS ports by convention, neither listens
# for a handshake. Point the proxy at them over http://.
S3_PORT=8443
CONSOLE_PORT=8444

# ─── Public identity ──────────────────────────────────────────────────────────
# REQUIRED in production. Defaulted to localhost when ENV=development.
#
# The URLs clients actually reach you on. TLS terminates at your reverse proxy,
# so the app itself always serves plain HTTP.
#
# These must be right: SigV4 signs the hostname, so a mismatch here makes every
# S3 request fail with SignatureDoesNotMatch and no clue why.
PUBLIC_S3_URL=https://s3.example.com
PUBLIC_CONSOLE_URL=https://console.example.com

# optional — leave empty unless you want bucket subdomains.
#
# Set this to enable virtual-host style addressing, where a request
# to mybucket.s3.example.com resolves to the bucket "mybucket". Needs a
# wildcard DNS record and certificate. Leave empty for path style only
# (s3.example.com/mybucket), which every SDK supports.
S3_DOMAIN=

# optional — defaults to us-east-1, which is what most tools assume.
#
# A label, not a location: nothing is stored anywhere but this machine. It only
# has to match what your clients are configured with. SigV4 signs it, so a
# mismatch fails every request with SignatureDoesNotMatch.
S3_REGION=us-east-1

# ─── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. Any value; it never leaves the compose network.
#
# Postgres holds metadata only: buckets, object records, users, credentials.
# Object bytes never go in here.
#
# This is interpolated into a connection URL, so it must not contain characters
# that are special in one: "/", "@", "?", "#", ":" or "%". Hex or alphanumeric
# is safest — `openssl rand -hex 24`. A "/" here fails at startup with
# "invalid port after host", which points nowhere near the password.
POSTGRES_PASSWORD=change-me

# ─── Console authentication ───────────────────────────────────────────────────
# REQUIRED. The first account, and the one that creates every other user.
#
# It is re-promoted to administrator on every start, which is the way back in if
# the last admin is removed by accident.
#
# The account is created automatically, but nothing can invent a password for
# it. Until you set one, nobody can sign in:
#
#   docker compose exec s3d s3d user set-password you@example.com
ADMIN_EMAIL=you@example.com

# REQUIRED. Signs session cookies. At least 32 characters.
#   openssl rand -base64 32
SESSION_SECRET=

# REQUIRED. Encrypts S3 secret keys at rest (AES-256-GCM). At least 32 characters.
#   openssl rand -base64 32
#
# Unlike a password, an S3 secret cannot be stored as a one-way hash: SigV4
# re-derives the signing key from the secret on every request, so the server
# has to be able to recover it.
#
# BACK THIS UP. Changing or losing it makes every existing S3 credential
# undecryptable, and they all have to be reissued.
CREDENTIALS_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
# optional — nothing about signing in depends on this.
#
# Resend, for alert notifications only. Signing in does not use email at all, so
# leaving this empty costs you nothing but alert delivery — alerts still appear
# in the console, they just do not reach you when you are not looking at it.
#
# These are only the initial value. Once alert email is saved in the console
# under Settings, the stored configuration wins and these are ignored, which is
# what lets a rejected key be corrected without a redeploy.
RESEND_API_KEY=
RESEND_FROM=Pail <no-reply@example.com>

# ─── Networking ───────────────────────────────────────────────────────────────
# optional — the defaults cover the usual private ranges.
#
# CIDRs permitted to set X-Forwarded-* headers. Requests from anywhere else
# have those headers ignored, so an outside caller cannot spoof the public
# hostname and defeat signature verification. Narrow this to your proxy's
# address if you can.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Which host interface the ports bind to. Loopback by default so only a reverse
# proxy on the same host can reach them. The production overlay pins these.
S3_BIND=127.0.0.1
CONSOLE_BIND=127.0.0.1

# ─── Logging ──────────────────────────────────────────────────────────────────
# optional — all three have sensible defaults.
#
# debug, info, warn or error.
LOG_LEVEL=info

# What fraction of successful requests are kept in the queryable request log,
# between 0 and 1. Failures are always kept regardless.
#
# The Performance page corrects for this when estimating latency percentiles,
# so a low rate costs accuracy rather than correctness. Raise it on a quiet
# deployment where you would rather have the detail; 1 keeps everything.
LOG_SAMPLE_RATE=0.01

# How slow a request has to be, in milliseconds, to be kept regardless of the
# sample rate and shown by the "Slow only" filter on the Logs page.
LOG_SLOW_REQUEST_MS=3000

# ─── Monitoring ───────────────────────────────────────────────────────────────
# optional — the endpoint works without it, for signed-in administrators only.
#
# A bearer token for Prometheus to scrape /metrics on the console port.
#
# Leave it unset and the endpoint is still there, but only a signed-in
# administrator can read it. That is deliberate: bucket names, object counts and
# traffic volume together describe who is using this system and how much, so an
# open /metrics is a quiet information leak.
#
#   METRICS_TOKEN=$(openssl rand -hex 32)
#
# See docs/monitoring.md for the scrape config, a Grafana dashboard and a
# starting set of alerting rules.
METRICS_TOKEN=
