# Local environment
.env

# Build output
/bin/
/dist/
# Anchored: an unanchored "s3d" would also ignore the cmd/s3d package directory.
/s3d

# Local data volume
/data/

# Frontend
web/node_modules/
web/dist/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Built console assets. Produced by the Vite build and embedded at compile
# time; the directory itself is tracked (with .gitkeep) because go:embed needs
# it to exist for the Go build to work without a frontend build first.
/internal/web/dist/*
!/internal/web/dist/.gitkeep
